    "pairing": "paired differences between two heroes on the same deal pair against the same opponent (identical cards, seats and opponent random streams)",
    "per_opponent": "descriptive only (16 comparisons: about 0.8 intervals would exclude 0 by chance at 5%)",
    "primary": {
      "control": "ev_situation",
      "decision": "two-sided test at alpha = 0.05: the ML agent is better if the interval lies above 0, worse if below 0; otherwise no difference is detected",
      "estimand": "equal-weight mean over the 16 opponents of the mean paired difference per deal pair (bb/100)",
      "interval": "95% normal interval: mean +/- 1.96 x sqrt(sum over opponents of SE_o^2) / 16, SE_o = sample SD of the opponent's paired differences / sqrt(500)",
      "name": "ML EV minus Situation-Aware Frequency EV",
      "treatment": "ev_ml"
    },
    "secondary": [
