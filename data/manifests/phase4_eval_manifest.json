  "analysis": {
    "descriptive": "all six pairwise hero comparisons, win rates, all-in rates and all-in-hand results, low-coverage reliance, decision latency",
    "document": "docs/phase4_analysis_plan.md",
    "errors": "any match error or illegal action invalidates the run: no primary result is reported from an incomplete run; a fix is a documented protocol deviation and requires a new freeze",
