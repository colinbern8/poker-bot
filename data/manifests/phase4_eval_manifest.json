    "secondary_rule": "same estimator and 95% interval as the primary, not adjusted for multiplicity; supporting evidence only",
    "sensitivity": "stratified bootstrap of the primary (deal pairs resampled within each opponent, 10000 replicates, seed derive_seed(4000, 'bootstrap', 'primary')); the decision uses the normal interval",
    "subgroups": "training pool (12) vs held-out (4) opponents, and each style (4 opponents each), equal weight within the group; exploratory, no confirmatory claims",
